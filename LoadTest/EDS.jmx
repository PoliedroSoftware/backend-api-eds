        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor General Auditoría y valores comunes" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.time.LocalDateTime
import java.time.format.DateTimeFormatter
import java.util.UUID

// Formato ISO para timestamp
def formatter = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss&quot;)

// Variables comunes
def now = LocalDateTime.now().format(formatter)
def randomUUID = UUID.randomUUID().toString()
def user = &quot;QA_LoadTest_User&quot;

// Set variables globales
vars.put(&quot;nowISO&quot;, now)  //para timestamps
vars.put(&quot;loadTestUser&quot;, user) //para auditoría
vars.put(&quot;randomUUID&quot;, randomUUID)   // para asegurar valores únicos

// (Opcional) Si necesitas una marca única por ejecución
vars.put(&quot;runTag&quot;, &quot;LT-&quot; + now.replaceAll(&quot;[-:T]&quot;, &quot;&quot;).substring(0, 12))

log.info(&quot;📌 Variables globales JSR223 General inicializadas&quot;)
</stringProp>
          <stringProp name="TestPlan.comments">Auditoria</stringProp>
        </JSR223PreProcessor>
