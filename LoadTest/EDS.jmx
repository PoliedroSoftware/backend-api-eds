          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor Category POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 1. Obtener el número de descripciones existentes (matchNr lo da el JSON Extractor)
int nDesc = vars.get(&quot;existingCategoryDescriptions_matchNr&quot;) as Integer

// 2. Crear una lista con todas las descripciones actuales extraídas
def existingDescriptions = (1..nDesc).collect {
    vars.get(&quot;existingCategoryDescriptions_&quot; + it)
}

// 3. Preparar un generador aleatorio de texto para la nueva descripción
def newDesc = &quot;&quot;
def alphabet = (&apos;a&apos;..&apos;z&apos;) + (&apos;A&apos;..&apos;Z&apos;)  // Letras posibles
Random rand = new Random()

// 4. Generar una descripción de 12 letras que no exista aún
while (true) {
    newDesc = (1..12).collect { alphabet[rand.nextInt(alphabet.size())] }.join()
    if (!existingDescriptions.contains(newDesc)) break  // Asegura unicidad
}

// 5. Guardar la descripción para usarla en el body del POST
vars.put(&quot;uniqueCategoryDescription&quot;, newDesc)
</stringProp>
          </JSR223PreProcessor>
