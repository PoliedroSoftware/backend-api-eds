            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="GET_RANDOM_EDS_ID_FOR_DELETE" enabled="true">
              <stringProp name="dataSource">MySQL_Connection</stringProp>
              <stringProp name="query">SELECT e.id_eds
FROM eds e
LEFT JOIN court c ON e.id_eds = c.id_eds
LEFT JOIN dispensers d ON e.id_eds = d.id_eds
LEFT JOIN eds_tank et ON e.id_eds = et.id_eds
LEFT JOIN islander i ON e.id_eds = i.id_eds
WHERE c.id_eds IS NULL
  AND d.id_eds IS NULL
  AND et.id_eds IS NULL
  AND i.id_eds IS NULL
ORDER BY RAND()
LIMIT 1</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames">delete_eds_id</stringProp>
              <stringProp name="TestPlan.comments"> Obtiene un id_eds que es seguro de eliminar, verificando que no esté siendo usado en las tablas court, dispensers, eds_tank e islander.</stringProp>
            </JDBCSampler>
