LEFT JOIN court_expenditures ce ON c.id_court = ce.id_court
LEFT JOIN court_type_of_collection cht ON c.id_court = cht.id_court
WHERE cd.id_court IS NULL
  AND cdoc.id_court IS NULL
  AND ce.id_court IS NULL
  AND cht.id_court IS NULL
ORDER BY RAND()
LIMIT 1</stringProp>
              <stringProp name="queryArguments"></stringProp>
