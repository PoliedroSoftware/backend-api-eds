          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Lee el contenido de la variable JMeter que almacena el resultado del SELECT de la tabla tank
def tanksRaw = vars.get(&quot;id_tank_vars&quot;)

// Si la variable está vacía o nula, asigna el valor por defecto &quot;1&quot; a random_id_tank
if (tanksRaw == null || tanksRaw.trim().length() == 0) {
    vars.put(&quot;random_id_tank&quot;, &quot;1&quot;) // Valor por defecto, puedes cambiarlo o lanzar error si prefieres
} else {
    // Busca todos los valores de id_tank en el texto usando una expresión regular (regex)
    def matches = (tanksRaw =~ /id_tank=(\d+)/)
    if (matches.count) {
        // Si encontró uno o más id_tank, elige uno aleatoriamente de la lista de coincidencias
        def randomMatch = matches[(int)(Math.random() * matches.count)]
        // Guarda el valor elegido en la variable JMeter random_id_tank
        vars.put(&quot;random_id_tank&quot;, randomMatch[1])
    } else {
        // Si no encontró ningún id_tank, asigna el valor por defecto &quot;1&quot;
        vars.put(&quot;random_id_tank&quot;, &quot;1&quot;) // Valor por defecto si no encuentra
    }
}
</stringProp>
            </JSR223PreProcessor>
