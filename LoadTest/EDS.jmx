          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor Compartment PUT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// ====================================
// PREPROCESSOR: Compartment PUT
// ====================================

// 1. Cargar todos los numbers existentes
def totalNumbers = vars.get(&quot;existingCompartmentNumbers_matchNr&quot;) as Integer
def numbers = (1..totalNumbers).collect {
    vars.get(&quot;existingCompartmentNumbers_${it}&quot;) as Integer
}

// 2. Obtener el número actual del registro a modificar
def currentNumber = vars.get(&quot;currentCompartmentNumber&quot;) as Integer

// 3. Eliminar el actual para permitir dejarlo igual si es necesario
numbers.removeElement(currentNumber)

// 4. Generar un nuevo número no repetido
def newNumber
def random = new Random()
do {
    newNumber = random.nextInt(1000) + 1
} while (numbers.contains(newNumber))

// 5. Datos de auditoría
def now = org.apache.commons.lang3.time.FastDateFormat.getInstance(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date())
def username = org.apache.commons.lang3.RandomStringUtils.randomAlphanumeric(8)

// 6. Guardar variables en JMeter
vars.put(&quot;uniqueCompartmentNumber&quot;, newNumber.toString())
vars.put(&quot;updatedBy&quot;, username)
vars.put(&quot;updatedAt&quot;, now)
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
