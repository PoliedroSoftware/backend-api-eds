              <stringProp name="dataSource">MySQL_Connection</stringProp>
              <stringProp name="query">SELECT id_tank FROM tank ORDER BY RAND() LIMIT 1</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames">update_tank_id</stringProp>
              <stringProp name="TestPlan.comments"> Selecciona un id_tank aleatorio para usarlo en la operación de UPDATE.</stringProp>
            </JDBCSampler>
            <hashTree/>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="GET_RANDOM_TANK_ID_FOR_DELETE" enabled="true">
              <stringProp name="dataSource">MySQL_Connection</stringProp>
              <stringProp name="query">SELECT t.id_tank
FROM tank t
LEFT JOIN compartiment c ON t.id_tank = c.id_tank
LEFT JOIN eds_tank et ON t.id_tank = et.id_tank
LEFT JOIN tank_history th ON t.id_tank = th.id_tank
WHERE c.id_tank IS NULL 
  AND et.id_tank IS NULL 
  AND th.id_tank IS NULL
ORDER BY RAND()
LIMIT 1</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames">delete_tank_id</stringProp>
              <stringProp name="TestPlan.comments">Obtiene un id_tank que es seguro de eliminar, verificando que no esté siendo usado en compartiment, eds_tank, ni en tank_history.</stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
