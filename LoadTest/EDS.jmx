def user = vars.get(&quot;loadTestUser&quot;)

vars.put(&quot;createdBy&quot;, user)
vars.put(&quot;createdAt&quot;, now)

// Generar una descripción única usando runTag + threadNum + UUID
def runTag = vars.get(&quot;runTag&quot;)
def threadNum = ctx.getThreadNum()
def uuidPart = UUID.randomUUID().toString().take(8)

def description = &quot;isla_${runTag}_${threadNum}_${uuidPart}&quot;
vars.put(&quot;description&quot;, description)


</stringProp>
