  &quot;request&quot;: {&#xd;
    &quot;idProduct&quot;: ${selectedProductId},&#xd;
    &quot;idCompartiment&quot;: ${selectedCompartimentId},&#xd;
    &quot;stock&quot;: ${__Random(1,10000)}&#xd;
  }&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
