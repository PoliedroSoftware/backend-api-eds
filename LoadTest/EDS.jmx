          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// ----------- FUNCION REUTILIZABLE PARA TOMAR UN ID ALEATORIO -----------

/**
 * Busca todos los valores de un campo en el texto de una variable,
 * elige uno aleatorio y lo guarda como variable JMeter.
 *
 * @param varName    Nombre de la variable resultado del SELECT (ej: &quot;islander_vars&quot;)
 * @param fieldName  Nombre del campo a buscar (ej: &quot;id_islander&quot;)
 * @param resultVar  Nombre de la variable JMeter donde guardar el resultado (ej: &quot;random_id_islander&quot;)
 * @param defaultVal Valor por defecto si no se encuentra nada (ej: &quot;1&quot;)
 */
def pickRandomId(varName, fieldName, resultVar, defaultVal=&quot;1&quot;) {
    // Obtiene el texto de la variable de resultados o &quot;&quot; si no existe
    def raw = vars.get(varName) ?: &quot;&quot;
    // Busca todos los valores del campo usando expresión regular
    def matches = (raw =~ /${fieldName}=(\d+)/)
    // Cuenta cuántos encontró
    def count = matches.count
    if (count &gt; 0) {
        // Elige un índice aleatorio
        def idx = (int)(Math.random() * count)
        // Toma el valor del id aleatorio
        vars.put(resultVar, matches[idx][1])
    } else {
        // Si no encuentra ningún id, asigna el valor por defecto
        vars.put(resultVar, defaultVal)
    }
}

// ---------- LLAMADAS A LA FUNCIÓN PARA CADA CLAVE FORÁNEA -----------

// Para el campo id_islander (tablas court → islander)
pickRandomId(&quot;islander_vars&quot;, &quot;id_islander&quot;, &quot;random_id_islander&quot;)
// Para el campo id_eds (tablas court → eds)
pickRandomId(&quot;eds_vars&quot;, &quot;id_eds&quot;, &quot;random_id_eds&quot;)

// Si agregas más claves foráneas, solo agregas otra línea:
// pickRandomId(&quot;nombre_vars&quot;, &quot;campo&quot;, &quot;variable_resultado&quot;)
</stringProp>
            </JSR223PreProcessor>
