          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// ===== Función reutilizable para elegir id aleatorio =====

/**
 * Busca todos los valores de un campo en el resultado del SELECT,
 * elige uno aleatorio y lo guarda como variable JMeter.
 */
def pickRandomId(varName, fieldName, resultVar, defaultVal=&quot;1&quot;) {
    // Obtiene el texto completo de la variable de resultados, si no existe usa &quot;&quot;
    def raw = vars.get(varName) ?: &quot;&quot;
    // Busca todos los valores del campo usando una expresión regular
    def matches = (raw =~ /${fieldName}=(\d+)/)
    def count = matches.count
    if (count &gt; 0) {
        // Si hay resultados, elige uno aleatorio
        def idx = (int)(Math.random() * count)
        vars.put(resultVar, matches[idx][1])
    } else {
        // Si no hay resultados, usa valor por defecto
        vars.put(resultVar, defaultVal)
    }
}

// === Llamadas para este INSERT ===
pickRandomId(&quot;shopping_vars&quot;, &quot;id_shopping&quot;, &quot;random_id_shopping&quot;)
pickRandomId(&quot;product_vars&quot;, &quot;id_product&quot;, &quot;random_id_product&quot;)
pickRandomId(&quot;compartiment_vars&quot;, &quot;id_compartiment&quot;, &quot;random_id_compartiment&quot;)
</stringProp>
          </JSR223PreProcessor>
