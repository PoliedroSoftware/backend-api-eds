    vars.put(&quot;random_id_provider&quot;, provMatches[idx][1])
} else {
    log.error(&quot;NO HAY IDS EN PROVIDER PARA UPDATE!&quot;)
    vars.put(&quot;random_id_provider&quot;, &quot;1&quot;)
}

// Escoge un id_category aleatorio
