          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor CompartimentCapacity PUT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Este PreProcessor asigna y asegura las variables necesarias para actualizar un registro compartiment_capacity

// 1. Obtener el ID de la relación existente desde el extractor
String idCompartimentCapacity = vars.get(&quot;selectedCompartimentCapacityId&quot;)

// 2. Obtener valores previamente extraídos
String idCompartment = vars.get(&quot;selectedCompartmentId&quot;)
String idCapacity = vars.get(&quot;selectedCapacityId&quot;)

// 3. Generar un valor booleano para default (1 a 20)
int defaultValue = new Random().nextInt(20) + 1

// 4. Asignar al contexto de JMeter
vars.put(&quot;selectedCompartimentCapacityId&quot;, idCompartimentCapacity)
vars.put(&quot;selectedCompartmentId&quot;, idCompartment)
vars.put(&quot;selectedCapacityId&quot;, idCapacity)
vars.put(&quot;defaultValue&quot;, String.valueOf(defaultValue))
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="CompartimentCapacity PUT" enabled="true">
            <stringProp name="HTTPSampler.domain">${server}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">${protocolo}</stringProp>
            <stringProp name="HTTPSampler.path">eds/api/v1/compartiment-capacity</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">PUT</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;idCompartimentCapacity&quot;: ${selectedCompartimentCapacityId},&#xd;
  &quot;idCompartment&quot;: ${selectedCompartmentId},&#xd;
  &quot;idCapacity&quot;: ${selectedCapacityId},&#xd;
  &quot;default&quot;: ${__Random(1,20)},&#xd;
  &quot;updatedBy&quot;: &quot;${updatedBy}&quot;,&#xd;
  &quot;updatedAt&quot;: &quot;${updatedAt}&quot;&#xd;
}&#xd;
</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
