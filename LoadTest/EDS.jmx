            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Asigna claves foráneas previamente extraídas por los extractores GET
String idShoppingProduct = vars.get(&quot;selectedShoppingProductId&quot;);
String idInventory = vars.get(&quot;selectedInventoryId&quot;);

// Verifica existencia de claves foráneas
if (idShoppingProduct == null || idInventory == null) {
    throw new IllegalStateException(&quot;Faltan valores requeridos para idShoppingProduct o idInventory&quot;);
}

// No se genera un valor nuevo para idShoppingProductInventory porque se reutiliza uno existente aleatorio
vars.put(&quot;selectedShoppingProductId&quot;, idShoppingProduct);
vars.put(&quot;selectedInventoryId&quot;, idInventory);
</stringProp>
          </JSR223PreProcessor>
