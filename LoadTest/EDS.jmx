              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Escoge un registro aleatorio de shopping (id_shopping y amount)
def shopRaw = vars.get(&quot;shopping_vars&quot;) ?: &quot;&quot;
def shopMatches = (shopRaw =~ /id_shopping=(\d+), amount=([\d.]+)/)
if (shopMatches.count &gt; 0) {
    def idx = (int)(Math.random() * shopMatches.count)
    vars.put(&quot;random_id_shopping&quot;, shopMatches[idx][1])
    vars.put(&quot;random_amount&quot;, shopMatches[idx][2])
} else {
    log.error(&quot;NO HAY IDS EN SHOPPING PARA UPDATE!&quot;)
    vars.put(&quot;random_id_shopping&quot;, &quot;1&quot;)
    vars.put(&quot;random_amount&quot;, &quot;0&quot;)
}

// Escoge un id_provider aleatorio
def provRaw = vars.get(&quot;provider_vars&quot;) ?: &quot;&quot;
def provMatches = (provRaw =~ /id_provider=(\d+)/)
if (provMatches.count &gt; 0) {
    def idx = (int)(Math.random() * provMatches.count)
    vars.put(&quot;random_id_provider&quot;, provMatches[idx][1])
} else {
    log.error(&quot;NO HAY IDS EN PROVIDER PARA UPDATE!&quot;)
    vars.put(&quot;random_id_provider&quot;, &quot;1&quot;)
}

// Escoge un id_category aleatorio
def catRaw = vars.get(&quot;category_vars&quot;) ?: &quot;&quot;
def catMatches = (catRaw =~ /id_category=(\d+)/)
if (catMatches.count &gt; 0) {
    def idx = (int)(Math.random() * catMatches.count)
    vars.put(&quot;random_id_category&quot;, catMatches[idx][1])
} else {
    log.error(&quot;NO HAY IDS EN CATEGORY PARA UPDATE!&quot;)
    vars.put(&quot;random_id_category&quot;, &quot;1&quot;)
}
</stringProp>
