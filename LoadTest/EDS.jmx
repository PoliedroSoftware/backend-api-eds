          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor  TypeOfCollection PUT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Nueva descripción para mantener unicidad
String updatedDescription = &quot;typeCol_&quot; + UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 8);
vars.put(&quot;descriptionTypeOfCollection&quot;, updatedDescription);

// Auditoría
vars.put(&quot;updatedBy&quot;, vars.get(&quot;loadTestUser&quot;));
vars.put(&quot;updatedAt&quot;, vars.get(&quot;nowISO&quot;));
</stringProp>
          </JSR223PreProcessor>
