            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Genera un nuevo código aleatorio más corto para actualización
vars.put(&quot;code&quot;, org.apache.commons.lang3.RandomStringUtils.randomAlphanumeric(5));

// Nuevo número aleatorio entre 1 y 10 para el campo number
vars.put(&quot;number&quot;, String.valueOf(org.apache.commons.lang3.RandomUtils.nextInt(1, 11)));

// Genera un número aleatorio para manguera también
vars.put(&quot;hoseNumber&quot;, String.valueOf(org.apache.commons.lang3.RandomUtils.nextInt(1, 11)));

// Asigna fecha actual en formato ISO para updatedAt
vars.put(&quot;updatedAt&quot;, vars.get(&quot;nowISO&quot;));

// Reutiliza nombre de usuario de carga
vars.put(&quot;updatedBy&quot;, vars.get(&quot;loadTestUser&quot;));
</stringProp>
          </JSR223PreProcessor>
