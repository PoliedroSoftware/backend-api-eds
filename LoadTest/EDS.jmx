            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 1. Obtener listas de IDs disponibles
def allProducts = (1..(vars.get(&apos;allProductIds_matchNr&apos;) as int)).collect { vars.get(&quot;allProductIds_${it}&quot;) }
def allCompartiments = (1..(vars.get(&apos;allCompartimentIds_matchNr&apos;) as int)).collect { vars.get(&quot;allCompartimentIds_${it}&quot;) }

// 2. Listas de combinaciones ya usadas
def usedProducts = (1..(vars.get(&apos;usedProductIds_matchNr&apos;) as int)).collect { vars.get(&quot;usedProductIds_${it}&quot;) }
def usedCompartiments = (1..(vars.get(&apos;usedCompartimentIds_matchNr&apos;) as int)).collect { vars.get(&quot;usedCompartimentIds_${it}&quot;) }

// 3. Crear pares existentes para comparar
def usedPairs = usedProducts.collectIndexed { idx, prodId -&gt;
    [prodId, usedCompartiments[idx]]
}

// 4. Buscar una combinación libre
def freePair = null
outer:
for (prodId in allProducts) {
    for (compId in allCompartiments) {
        if (!usedPairs.contains([prodId, compId])) {
            freePair = [prodId, compId]
            break outer
        }
    }
}

// 5. Si encuentra combinación libre, setear variables; si no, usa cualquier combinación random
if (freePair) {
    vars.put(&quot;selectedProductId&quot;, freePair[0])
    vars.put(&quot;selectedCompartimentId&quot;, freePair[1])
} else {
    vars.put(&quot;selectedProductId&quot;, allProducts[new Random().nextInt(allProducts.size())])
    vars.put(&quot;selectedCompartimentId&quot;, allCompartiments[new Random().nextInt(allCompartiments.size())])
}

// Ahora puedes usar ${selectedProductId} y ${selectedCompartimentId} en el body del POST
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
