            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="GET_RANDOM_PRODUCT_ID_FOR_DELETE" enabled="true">
              <stringProp name="dataSource">MySQL_Connection</stringProp>
              <stringProp name="query">SELECT p.id_product
FROM product p
LEFT JOIN compartiment c ON p.id_product = c.id_product
LEFT JOIN court_dispensers cd ON p.id_product = cd.id_product
LEFT JOIN product_history ph ON p.id_product = ph.id_product
LEFT JOIN shopping_product sp ON p.id_product = sp.id_product
WHERE c.id_product IS NULL
  AND cd.id_product IS NULL
  AND ph.id_product IS NULL
  AND sp.id_product IS NULL
ORDER BY RAND()
LIMIT 1</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames">delete_product_id</stringProp>
              <stringProp name="TestPlan.comments"> Obtiene un id_product que es seguro de eliminar, verificando que no esté siendo usado en ninguna de las tablas dependientes (compartiment, court_dispensers,product_history y shopping_product).</stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
