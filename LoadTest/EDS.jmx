          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor ProductCompartment PUT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 1. Obtener lista de IDs existentes
def total = vars.get(&quot;allProductCompartmentIds_matchNr&quot;) as int
def allIds = (1..total).collect { vars.get(&quot;allProductCompartmentIds_$it&quot;) }

// 2. Elegir uno al azar
def idx = new Random().nextInt(allIds.size())
vars.put(&quot;selectedProductCompartmentId&quot;, allIds[idx])

// 3. Auditoría
vars.put(&quot;updatedBy&quot;, vars.get(&quot;loadTestUser&quot;))
vars.put(&quot;updatedAt&quot;, vars.get(&quot;nowISO&quot;))

// Nota: Si se requiere también el idProduct y idCompartment relacionados, se pueden extraer con JSON Extractors adicionales usando el idProductCompartment elegido.
</stringProp>
          </JSR223PreProcessor>
