          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor EdsTank POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 1. Obtener todos los posibles Eds y Tank
def nEds = vars.get(&quot;allEdsIds_matchNr&quot;) as Integer
def nTanks = vars.get(&quot;allTankIds_matchNr&quot;) as Integer

def allEdsIds = (1..nEds).collect { vars.get(&quot;allEdsIds_${it}&quot;) }
def allTankIds = (1..nTanks).collect { vars.get(&quot;allTankIds_${it}&quot;) }

// 2. Obtener las combinaciones ya existentes
def nEdsTank = vars.get(&quot;existingEdsTankIds_matchNr&quot;) as Integer
def existingCombos = (1..nEdsTank).collect {
  [vars.get(&quot;existingEdsIds_${it}&quot;), vars.get(&quot;existingTankIds_${it}&quot;)]
}

// 3. Buscar una combinación libre
def freeCombo = null
outer:
for (eds in allEdsIds) {
  for (tank in allTankIds) {
    if (!existingCombos.contains([eds, tank])) {
      freeCombo = [eds, tank]
      break outer
    }
  }
}

if (freeCombo) {
  vars.put(&quot;selectedEdsId&quot;, freeCombo[0])
  vars.put(&quot;selectedTankId&quot;, freeCombo[1])
} else {
  // Si no hay combos libres, usar la primera combinación
  vars.put(&quot;selectedEdsId&quot;, allEdsIds[0])
  vars.put(&quot;selectedTankId&quot;, allTankIds[0])
}

// 4. Auditoría
vars.put(&quot;createdBy&quot;, vars.get(&quot;loadTestUser&quot;))
vars.put(&quot;createdAt&quot;, vars.get(&quot;nowISO&quot;))
</stringProp>
          </JSR223PreProcessor>
