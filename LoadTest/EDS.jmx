def now = java.time.ZonedDateTime.now(java.time.ZoneId.of(&quot;America/Bogota&quot;))
def nowISO = now.toString()

// Establece variables de auditoría
vars.put(&quot;createdBy&quot;, &quot;loadTestUser&quot;)      // Usuario fijo o de prueba
vars.put(&quot;createdAt&quot;, nowISO)              // Timestamp para createdAt
</stringProp>
