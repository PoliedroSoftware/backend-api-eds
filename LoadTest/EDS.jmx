          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// === Función reutilizable para tomar ids aleatorios ===

/**
 * Busca todos los valores de un campo en la variable de resultados,
 * elige uno aleatorio y lo guarda en una variable JMeter.
 */
def pickRandomId(varName, fieldName, resultVar, defaultVal=&quot;1&quot;) {
    // Lee el texto de la variable de resultados, si no existe usa &quot;&quot;
    def raw = vars.get(varName) ?: &quot;&quot;
    // Encuentra todos los valores del campo usando expresión regular
    def matches = (raw =~ /${fieldName}=(\d+)/)
    def count = matches.count
    if (count &gt; 0) {
        // Elige uno aleatorio
        def idx = (int)(Math.random() * count)
        vars.put(resultVar, matches[idx][1])
    } else {
        // Si no hay resultados, guarda valor por defecto
        vars.put(resultVar, defaultVal)
    }
}

// --- Llamadas para este INSERT ---
// Id aleatorio de la tabla court
pickRandomId(&quot;court_vars&quot;, &quot;id_court&quot;, &quot;random_id_court&quot;)
// Id aleatorio de la tabla product
pickRandomId(&quot;product_vars&quot;, &quot;id_product&quot;, &quot;random_id_product&quot;)
// Id aleatorio de la tabla compartiment
pickRandomId(&quot;compartiment_vars&quot;, &quot;id_compartiment&quot;, &quot;random_id_compartiment&quot;)
// Id aleatorio de la tabla hose
pickRandomId(&quot;hose_vars&quot;, &quot;id_hose&quot;, &quot;random_id_hose&quot;)
</stringProp>
            </JSR223PreProcessor>
