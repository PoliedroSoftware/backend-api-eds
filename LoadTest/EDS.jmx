          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// ======================
// Para id_compartiment
// ======================

// Obtiene el texto completo del resultado del SELECT sobre la tabla compartiment (si la variable no existe, usa &quot;&quot;)
def compartimentRaw = vars.get(&quot;compartiment_vars&quot;) ?: &quot;&quot;

// Busca todos los valores tipo id_compartiment=NUMERO usando una expresión regular (regex)
def compartimentMatches = (compartimentRaw =~ /id_compartiment=(\d+)/)

// Cuenta cuántos id_compartiment encontró en el resultado
def compartimentCount = compartimentMatches.count

if (compartimentCount &gt; 0) {
    // Si encontró uno o más, elige un índice aleatorio entre 0 y (compartimentCount-1)
    def idx = (int)(Math.random() * compartimentCount)
    // Toma el id_compartiment correspondiente a ese índice
    def randomCompartimentId = compartimentMatches[idx][1]
    // Guarda ese valor en la variable JMeter random_id_compartiment
    vars.put(&quot;random_id_compartiment&quot;, randomCompartimentId)
} else {
    // Si no encontró ningún id_compartiment, asigna el valor por defecto &quot;1&quot;
    vars.put(&quot;random_id_compartiment&quot;, &quot;1&quot;) // valor por defecto
}

// ======================
// Para id_capacity
// ======================

// Obtiene el texto completo del resultado del SELECT sobre la tabla capacity (si la variable no existe, usa &quot;&quot;)
def capacityRaw = vars.get(&quot;capacity_vars&quot;) ?: &quot;&quot;

// Busca todos los valores tipo id_capacity=NUMERO usando una expresión regular (regex)
def capacityMatches = (capacityRaw =~ /id_capacity=(\d+)/)

// Cuenta cuántos id_capacity encontró en el resultado
def capacityCount = capacityMatches.count

if (capacityCount &gt; 0) {
    // Si encontró uno o más, elige un índice aleatorio entre 0 y (capacityCount-1)
    def idx = (int)(Math.random() * capacityCount)
    // Toma el id_capacity correspondiente a ese índice
    def randomCapacityId = capacityMatches[idx][1]
    // Guarda ese valor en la variable JMeter random_id_capacity
    vars.put(&quot;random_id_capacity&quot;, randomCapacityId)
} else {
    // Si no encontró ningún id_capacity, asigna el valor por defecto &quot;1&quot;
    vars.put(&quot;random_id_capacity&quot;, &quot;1&quot;) // valor por defecto
}
</stringProp>
          </JSR223PreProcessor>
