        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Request POST " enabled="true"/>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor Business POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Generar nombre único para evitar colisión en constraint UNIQUE
def name = &quot;Business_&quot; + UUID.randomUUID().toString().substring(0, 8)

// Variables de auditoría
vars.put(&quot;businessName&quot;, name)
vars.put(&quot;createdBy&quot;, vars.get(&quot;loadTestUser&quot;))
vars.put(&quot;createdAt&quot;, vars.get(&quot;nowISO&quot;))
</stringProp>
