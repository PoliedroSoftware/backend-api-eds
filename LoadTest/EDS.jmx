            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 1. Obtener lista de IDs existentes
def total = vars.get(&apos;allProductCompartimentIds_matchNr&apos;) as int
def allIds = (1..total).collect { vars.get(&quot;allProductCompartimentIds_${it}&quot;) }

// 2. Elegir uno al azar
def idx = new Random().nextInt(allIds.size())
vars.put(&quot;selecteProductCompartimentId&quot;, allIds[idx])

// Si necesitas también el idProduct y idCompartiment asociados a ese id, crea extractores adicionales.
// O puedes usar extractores JMESPath para extraer los campos asociados al id elegido.
</stringProp>
            </JSR223PreProcessor>
