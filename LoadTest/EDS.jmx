          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor Dispensers POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Genera una cadena aleatoria para el código de 10 caracteres (letras y números)
vars.put(&quot;code&quot;, org.apache.commons.lang3.RandomStringUtils.randomAlphanumeric(10));

// Genera un número aleatorio entre 1 y 10 para el campo number
vars.put(&quot;number&quot;, String.valueOf(org.apache.commons.lang3.RandomUtils.nextInt(1, 11)));

// Genera un número aleatorio entre 1 y 10 para el número de manguera
vars.put(&quot;hoseNumber&quot;, String.valueOf(org.apache.commons.lang3.RandomUtils.nextInt(1, 11)));

// Asigna la fecha actual en formato ISO 8601
vars.put(&quot;createdAt&quot;, vars.get(&quot;nowISO&quot;));

// Reutiliza las variables comunes ya definidas globalmente
vars.put(&quot;createdBy&quot;, vars.get(&quot;loadTestUser&quot;));
</stringProp>
