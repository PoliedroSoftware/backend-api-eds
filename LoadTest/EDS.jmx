String idProduct = vars.get(&quot;selectedProductId&quot;)
String idCompartment = vars.get(&quot;selectedCompartmentId&quot;)

// Auditoría
vars.put(&quot;createdBy&quot;, vars.get(&quot;loadTestUser&quot;))
vars.put(&quot;createdAt&quot;, vars.get(&quot;nowISO&quot;))

// Guardar FKs por si no estaban ya disponibles
vars.put(&quot;idShopping&quot;, idShopping)
vars.put(&quot;idProduct&quot;, idProduct)
vars.put(&quot;idCompartment&quot;, idCompartment)
</stringProp>
