            <stringProp name="script">// Genera un nuevo número único para actualizar y cumplir con la restricción UNIQUE
String number = &quot;tnk_&quot; + UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 8);
