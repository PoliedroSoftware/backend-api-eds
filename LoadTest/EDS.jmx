            <stringProp name="script">// JSR223 PreProcessor para generar datos POST Hose

// Número aleatorio de manguera
vars.put(&quot;randomHoseNumber&quot;, String.valueOf(1 + (int)(Math.random() * 40)))

// Galones aleatorios
vars.put(&quot;randomGallons&quot;, String.valueOf(1 + (int)(Math.random() * 100)))

// Monto acumulado aleatorio
vars.put(&quot;randomAmount&quot;, String.valueOf(1 + (int)(Math.random() * 50)))

// Auditoría
vars.put(&quot;createdBy&quot;, vars.get(&quot;loadTestUser&quot;))
vars.put(&quot;createdAt&quot;, vars.get(&quot;nowISO&quot;))
</stringProp>
