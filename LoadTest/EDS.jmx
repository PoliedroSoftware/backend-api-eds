            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">UPDATE shopping
SET
  invoice=&apos;${__RandomString(10,0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ)}&apos;,
  `date`=&apos;${__time(Y-M-d)}&apos;,
  id_provider=${random_id_provider},
  id_category=${random_id_category}, 
  &apos;${__RandomString(8,abcdef)}&apos;,
  &apos;${__time(yyyy-MM-dd HH:mm:ss)}&apos;,
  &apos;${__RandomString(8,abcdef)}&apos;,
  &apos;${__time(yyyy-MM-dd HH:mm:ss)}&apos;
WHERE id_shopping=${random_id_shopping} AND amount=${random_amount};
</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
