            <stringProp name="script">// Este PreProcessor define variables necesarias para el POST del endpoint compartiment_capacity

// 1. Asignar un ID de Compartment aleatorio extraído en el extractor previo
String idCompartment = vars.get(&quot;selectedCompartmentId&quot;)

// 2. Asignar un ID de Capacity aleatorio extraído en el extractor previo
String idCapacity = vars.get(&quot;selectedCapacityId&quot;)

// 3. Definir un valor aleatorio para el campo booleano default (1 a 50 como ejemplo de distribución)
int defaultValue = new Random().nextInt(50) + 1

// 4. Asignar las variables al contexto de JMeter
vars.put(&quot;selectedCompartmentId&quot;, idCompartment)
vars.put(&quot;selectedCapacityId&quot;, idCapacity)
vars.put(&quot;defaultValue&quot;, String.valueOf(defaultValue))
</stringProp>
