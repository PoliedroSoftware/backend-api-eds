            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname=" GET_RANDOM_COMPARTIMENT_FOR_DELETE" enabled="true">
              <stringProp name="dataSource">MySQL_Connection</stringProp>
              <stringProp name="query">SELECT c.id_compartiment
FROM compartiment c
LEFT JOIN compartiment_capacity cc ON c.id_compartiment = cc.id_compartiment
LEFT JOIN court_dispensers cd ON c.id_compartiment = cd.id_compartiment
LEFT JOIN hose h ON c.id_compartiment = h.id_compartiment
LEFT JOIN shopping_product sp ON c.id_compartiment = sp.id_compartiment
WHERE cc.id_compartiment IS NULL
  AND cd.id_compartiment IS NULL
  AND h.id_compartiment IS NULL
  AND sp.id_compartiment IS NULL
ORDER BY RAND()
LIMIT 1</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames">delete_compartment_id</stringProp>
              <stringProp name="TestPlan.comments">Obtiene un id_compartiment que es seguro de eliminar, verificando que no esté siendo usado en ninguna de las tablas dependientes (compartiment_capacity, court_dispensers, hose, shopping_product).</stringProp>
            </JDBCSampler>
