          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor ProductCompartment POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Obtener listas de IDs disponibles
def allProducts = (1..(vars.get(&quot;allProductIds_matchNr&quot;) as int)).collect { vars.get(&quot;allProductIds_$it&quot;) }
def allCompartments = (1..(vars.get(&quot;allCompartmentIds_matchNr&quot;) as int)).collect { vars.get(&quot;allCompartmentIds_$it&quot;) }

// Obtener combinaciones ya utilizadas
def usedProducts = (1..(vars.get(&quot;usedProductIds_matchNr&quot;) as int)).collect { vars.get(&quot;usedProductIds_$it&quot;) }
def usedCompartments = (1..(vars.get(&quot;usedCompartmentIds_matchNr&quot;) as int)).collect { vars.get(&quot;usedCompartmentIds_$it&quot;) }
def usedPairs = usedProducts.collectIndexed { idx, p -&gt; [p, usedCompartments[idx]] }

// Buscar combinación no usada
def freePair = null
outer:
for (p in allProducts) {
  for (c in allCompartments) {
    if (!usedPairs.contains([p, c])) {
      freePair = [p, c]
      break outer
    }
  }
}

// Asignar IDs
if (freePair != null) {
  vars.put(&quot;selectedProductId&quot;, freePair[0])
  vars.put(&quot;selectedCompartmentId&quot;, freePair[1])
} else {
  // Si no hay combinación libre, usar aleatoria
  def rand = new Random()
  vars.put(&quot;selectedProductId&quot;, allProducts[rand.nextInt(allProducts.size())])
  vars.put(&quot;selectedCompartmentId&quot;, allCompartments[rand.nextInt(allCompartments.size())])
}

// Variables de auditoría
vars.put(&quot;createdBy&quot;, vars.get(&quot;loadTestUser&quot;))
vars.put(&quot;createdAt&quot;, vars.get(&quot;nowISO&quot;))
</stringProp>
          </JSR223PreProcessor>
