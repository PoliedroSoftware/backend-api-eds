            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 1. Obtener todos los posibles Eds y Tank
def nEds = vars.get(&apos;allEdsIds_matchNr&apos;) as Integer
def nTanks = vars.get(&apos;allTankIds_matchNr&apos;) as Integer

def allEdsIds = (1..nEds).collect { vars.get(&quot;allEdsIds_${it}&quot;) }
def allTankIds = (1..nTanks).collect { vars.get(&quot;allTankIds_${it}&quot;) }

// 2. Obtener las combinaciones ya existentes
def nEdsTank = vars.get(&apos;existingEdsTankIds_matchNr&apos;) as Integer
def existingCombos = (1..nEdsTank).collect { [vars.get(&quot;existingEdsIds_${it}&quot;), vars.get(&quot;existingTankIds_${it}&quot;)] }

// 3. Buscar una combinación libre (no usada)
def freeCombo = null
outer: for (eds in allEdsIds) {
    for (tank in allTankIds) {
        if (!existingCombos.contains([eds, tank])) {
            freeCombo = [eds, tank]
            break outer
        }
    }
}
if (freeCombo) {
    vars.put(&quot;selectedEdsId&quot;, freeCombo[0])
    vars.put(&quot;selectedTankId&quot;, freeCombo[1])
} else {
    // Si no hay combos libres, usa cualquier combinación (o lanza error)
    vars.put(&quot;selectedEdsId&quot;, allEdsIds[0])
    vars.put(&quot;selectedTankId&quot;, allTankIds[0])
}
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
