            <stringProp name="query">INSERT INTO compartiment
(id_compartiment, `number`, nominal, operative, stock, height, id_tank, createdBy, createdAt, updatedBy, updatedAt )
VALUES(0, 
	${__Random(1,9)},
	${__Random(1,20000)},
	${__Random(1,20000)},
	${__Random(1,20000)},
	${__Random(1,200)},
	${random_id_tank}, 
  &apos;${__RandomString(8,abcdef)}&apos;,
  &apos;${__time(yyyy-MM-dd HH:mm:ss)}&apos;,
  &apos;${__RandomString(8,abcdef)}&apos;,
  &apos;${__time(yyyy-MM-dd HH:mm:ss)}&apos;);
</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
