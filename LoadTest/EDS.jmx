if (shopMatches.count &gt; 0) {
    def idx = (int)(Math.random() * shopMatches.count)
    vars.put(&quot;random_id_shopping&quot;, shopMatches[idx][1])
    vars.put(&quot;random_amount&quot;, shopMatches[idx][2])
} else {
    log.error(&quot;NO HAY IDS EN SHOPPING PARA UPDATE!&quot;)
    vars.put(&quot;random_id_shopping&quot;, &quot;1&quot;)
    vars.put(&quot;random_amount&quot;, &quot;0&quot;)
}

