            <stringProp name="query">INSERT INTO court
(id_court, id_islander, date_starttime, starttime, date_endtime, endtime, consecutive, id_eds, descripcion, distintic)
VALUES(
    0,
    ${random_id_islander},
    &apos;${__time(Y-M-d)}&apos;,
    &apos;${__time(HH:mm)}&apos;,
    &apos;${__time(Y-M-d)}&apos;,
    &apos;${__time(HH:mm)}&apos;,
    ${__Random(1,9999)},
    ${random_id_eds},
    &quot;${__RandomString(10,abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ)}&quot;,
    ${__Random(0,1)}
);
</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
