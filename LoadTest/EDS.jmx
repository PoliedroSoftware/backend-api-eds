def matches = (raw =~ /id_type_of_collection=(\d+)/)
if (matches.count &gt; 0) {
    def idx = (int)(Math.random() * matches.count)
    vars.put(&quot;random_id_type_of_collection&quot;, matches[idx][1])
} else {
    vars.put(&quot;random_id_type_of_collection&quot;, &quot;1&quot;)
}
</stringProp>
            </JSR223PreProcessor>
