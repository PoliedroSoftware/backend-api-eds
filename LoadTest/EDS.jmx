          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor POST Compartment POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// ====================================
// PREPROCESSOR: Compartment POST
// ====================================

// 1. Obtener la cantidad de números ya registrados
def totalNumbers = vars.get(&quot;existingCompartmentNumbers_matchNr&quot;) as Integer

// 2. Cargar todos los valores únicos actuales (números ya usados)
def numbers = (1..totalNumbers).collect {
    vars.get(&quot;existingCompartmentNumbers_${it}&quot;) as Integer
}

// 3. Generar un nuevo número aleatorio que no exista
def uniqueNumber
def random = new Random()

do {
    uniqueNumber = random.nextInt(9999) + 1
} while (numbers.contains(uniqueNumber))  // Validación contra duplicados

// 4. Guardar el número como variable para el body
vars.put(&quot;uniqueCompartmentNumber&quot;, uniqueNumber.toString())
</stringProp>
          </JSR223PreProcessor>
