          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor Island POST" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Variables comunes de auditoría
def now = vars.get(&quot;nowISO&quot;)
def user = vars.get(&quot;loadTestUser&quot;)

vars.put(&quot;createdBy&quot;, user)
vars.put(&quot;createdAt&quot;, now)

// Generar una descripción única usando runTag + threadNum + UUID
def runTag = vars.get(&quot;runTag&quot;)
def threadNum = ctx.getThreadNum()
def uuidPart = UUID.randomUUID().toString().take(8)

def description = &quot;isla_${runTag}_${threadNum}_${uuidPart}&quot;
vars.put(&quot;description&quot;, description)


</stringProp>
          </JSR223PreProcessor>
